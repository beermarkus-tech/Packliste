rules_version = '2';

// Rules for the "packliste" named database in the exercise-tracker Firebase
// project. Paste this into: Firebase console → Firestore Database →
// select the "packliste" database → Rules tab → Publish.
//
// Single-user app: every collection is restricted to one fixed Google
// account, identified by email rather than a hardcoded UID.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email == "beer.markus@gmail.com";
    }

    match /catalog/{itemId} {
      allow read, write: if isOwner();
    }

    match /buckets/{bucketId} {
      allow read, write: if isOwner();
    }

    match /templates/{templateId} {
      allow read, write: if isOwner();
    }

    match /trips/{tripId} {
      allow read, write: if isOwner();
    }
  }
}
